{
  "info": {
    "_postman_id": "2b0e1b64-66cf-4e58-8e55-gestao-financeira",
    "name": "Gestao Financeira API",
    "description": "Collection para testar os endpoints de categorias e transacoes da API de gestao financeira.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "defaultCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health-check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('API saudavel', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.include({ ok: true, name: 'gestao-financeira-api' });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Listar categorias",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": ["{{baseUrl}}"],
          "path": ["categories"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista categorias padrao', function () {",
              "  pm.response.to.have.status(200);",
              "  const categories = pm.response.json();",
              "  pm.expect(categories.length).to.be.at.least(5);",
              "  const income = categories.find((item) => item.name === 'income');",
              "  pm.expect(income).to.exist;",
              "  pm.collectionVariables.set('defaultCategoryId', income.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Criar categoria",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"health\",\n  \"displayName\": \"Saude\",\n  \"icon\": \"favorite\",\n  \"background\": \"#FFB6B6\",\n  \"isIncome\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": ["{{baseUrl}}"],
          "path": ["categories"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cria categoria customizada', function () {",
              "  pm.response.to.have.status(201);",
              "  const category = pm.response.json();",
              "  pm.expect(category).to.include({ name: 'health', displayName: 'Saude' });",
              "  pm.collectionVariables.set('categoryId', category.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Atualizar categoria",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"Saude e Bem-estar\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categoryId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Atualiza categoria customizada', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().displayName).to.eql('Saude e Bem-estar');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Excluir categoria",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{categoryId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Exclui categoria customizada', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Bloquear exclusao de categoria padrao",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{defaultCategoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["categories", "{{defaultCategoryId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Nao exclui categoria padrao', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error).to.eql('Categorias padrao nao podem ser excluidas');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Criar transacao",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Salario de outubro\",\n  \"value\": 3500.50,\n  \"date\": \"2026-04-29\",\n  \"categoryId\": \"{{defaultCategoryId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["transactions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cria transacao com categoria', function () {",
              "  pm.response.to.have.status(201);",
              "  const transaction = pm.response.json();",
              "  pm.expect(transaction.description).to.eql('Salario de outubro');",
              "  pm.expect(transaction.category).to.exist;",
              "  pm.collectionVariables.set('transactionId', transaction.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Listar transacoes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["transactions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista transacoes com categoria expandida', function () {",
              "  pm.response.to.have.status(200);",
              "  const transactions = pm.response.json();",
              "  pm.expect(transactions).to.be.an('array');",
              "  if (transactions.length > 0) {",
              "    pm.expect(transactions[0].category).to.exist;",
              "  }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Excluir transacao",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transactions/{{transactionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["transactions", "{{transactionId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Exclui transacao', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Validar erro em transacao invalida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["transactions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Zod bloqueia payload invalido', function () {",
              "  pm.response.to.have.status(400);",
              "  const body = pm.response.json();",
              "  pm.expect(body.error).to.eql('Dados invalidos');",
              "  pm.expect(body.details).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
